{
  "name": "mcp-server",
  "version": "1.0.0",
  "description": "MCP server exposing AuraCloud watchlist and AWS resource tools",
  "main": "./dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:http": "tsx watch src/http.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "dev:slack": "tsx watch src/slack/worker.ts",
    "start:slack": "node dist/slack/worker.js",
    "send-daily-summary": "tsx src/slack/sendDailySummary.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.2",
    "node-cron": "^4.6.0",
    "utils": "*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
